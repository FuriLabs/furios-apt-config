# This file is used to pick-up experimental (or otherwise in-progress) work
# related to the phone functionality.
# It gets installed by the furios-apt-config package and will be removed
# once the updated packages are upstream.

# gnome-calls: emergency numbers, dual sim, ims, libcallui fixes
Types: deb
URIs: http://furilabs-gnome-calls.repo.furios.io/forky-volte/
Suites: forky
Components: main
Signed-By: /etc/apt/trusted.gpg.d/furilabs.gpg

# chatty: drop modem number check in mmsd
Types: deb
URIs: http://furilabs-chatty.repo.furios.io/forky-mms-0-8-7/
Suites: forky
Components: main
Signed-By: /etc/apt/trusted.gpg.d/furilabs.gpg

# systemd: don't fail on any postinst script during upgrades
Components: main
Suites: forky
Uris: http://furilabs-systemd.repo.furios.io/forky-systemd-261-rc3/
Types: deb
Signed-By: /etc/apt/trusted.gpg.d/furilabs.gpg

# LXC7 two step upgrade. no fork, just upgrade path repo
Architectures: amd64 arm64
Components: main
Suites: forky
Uris: https://lxc.furios.io/
Types: deb
Signed-By: /etc/apt/trusted.gpg.d/furilabs.gpg
